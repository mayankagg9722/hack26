{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": [
    {
      "site": "zenai",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/.git/**",
        "**/.firebase/**",
        "**/node_modules/**",
        "*.mov",
        "*.mp4",
        "devpost/**",
        "functions/**"
      ],
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "/api/chat",
          "function": "chatWithClaude"
        },
        {
          "source": "/api/integrations",
          "function": "integrationsApi"
        },
        {
          "source": "/api/integrations/**",
          "function": "integrationsApi"
        },
        {
          "source": "/api/migration/**",
          "function": "integrationsApi"
        },
        {
          "source": "/api/mapping",
          "function": "integrationsApi"
        },
        {
          "source": "/api/mapping/**",
          "function": "integrationsApi"
        },
        {
          "source": "/api/goals",
          "function": "integrationsApi"
        },
        {
          "source": "/api/goals/**",
          "function": "integrationsApi"
        },
        {
          "source": "/api/runs",
          "function": "integrationsApi"
        },
        {
          "source": "/api/runs/**",
          "function": "integrationsApi"
        }
      ]
    },
